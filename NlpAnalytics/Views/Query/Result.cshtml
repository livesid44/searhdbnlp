@model NlpAnalytics.Models.QueryResult
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@{
    ViewData["Title"] = "Query Results";
    var camelCase = new JsonSerializerSettings { ContractResolver = new CamelCasePropertyNamesContractResolver() };
    var chartJson = Model.ChartData != null ? JsonConvert.SerializeObject(Model.ChartData, camelCase) : "null";

    // Identify pivot dimensions for the JS pivot engine
    var pivotRowColIdx = 0;
    var pivotColColIdx = 1;
    var pivotValColIdx = 2;
    if (Model.IsPivotable && Model.ColumnTypes.Count >= 3)
    {
        var stringIdxs = Model.ColumnTypes.Select((t, i) => (t, i)).Where(x => x.t == typeof(string)).Select(x => x.i).ToList();
        var numIdx = Model.ColumnTypes.Select((t, i) => (t, i))
            .FirstOrDefault(x => new HashSet<Type> { typeof(int), typeof(long), typeof(short), typeof(byte),
                typeof(float), typeof(double), typeof(decimal) }.Contains(x.t)).i;
        if (stringIdxs.Count >= 2) { pivotRowColIdx = stringIdxs[0]; pivotColColIdx = stringIdxs[1]; }
        pivotValColIdx = numIdx;
    }

    // Revenue columns: numeric columns whose name contains revenue/amount/sales/value/cost/price/budget/spend
    static bool IsRevenueColumn(string name) =>
        System.Text.RegularExpressions.Regex.IsMatch(name,
            @"(revenue|amount|sales|value|cost|price|budget|spend|earning|profit|loss|billing)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    var revenueColIndices = new HashSet<int>(
        Model.Columns.Select((name, i) => (name, i))
            .Where(x => IsRevenueColumn(x.name))
            .Select(x => x.i));

    string FormatCell(int colIdx, object? cell)
    {
        if (cell == null) return "<null>";
        if (revenueColIndices.Contains(colIdx) && decimal.TryParse(
                cell.ToString(),
                System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture,
                out var d))
            return "$" + d.ToString("N2") + "M";
        return cell.ToString() ?? "<null>";
    }
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-11">

            @* Back / question header *@
            <div class="d-flex align-items-center gap-2 mb-3">
                <a asp-controller="Query" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    ← New Query
                </a>
                <h5 class="mb-0 text-muted fst-italic">"@Model.NaturalLanguageQuery"</h5>
            </div>

            @if (Model.HasError)
            {
                <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                    <span class="fs-5"><i class="bi bi-exclamation-triangle-fill"></i></span>
                    <div>
                        <strong>Error</strong><br />@Model.ErrorMessage
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Interpretation))
            {
                <div class="alert alert-info d-flex align-items-start gap-2" role="alert">
                    <span class="fs-5"><i class="bi bi-lightbulb-fill"></i></span>
                    <div>
                        <strong>Interpretation:</strong> @Model.Interpretation
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.AiInsights))
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header fw-semibold bg-primary text-white">
                        <i class="bi bi-robot me-1"></i> AI Insights
                    </div>
                    <div class="card-body">
                        <div id="insightsContent" style="white-space:pre-line;">@Model.AiInsights</div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.ValidationWarning) && !Model.WasRepaired)
            {
                <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
                    <span class="fs-5"><i class="bi bi-tools"></i></span>
                    <div>
                        <strong>SQL column-name warning detected.</strong>
                        The AI-generated query may reference column names that do not exist in the database.
                        Please review the generated SQL and column names carefully.
                        <small class="d-block text-muted mt-1">Detail: @Model.ValidationWarning</small>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.GeneratedSql))
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <span>
                            <i class="bi bi-code-slash me-1"></i> Generated SQL
                            @if (Model.WasRepaired)
                            {
                                <span class="badge bg-warning text-dark ms-2" title="The original AI query contained invalid column names and was automatically corrected."><i class="bi bi-tools me-1"></i>Auto-corrected</span>
                            }
                        </span>
                        <button class="btn btn-sm btn-outline-light" id="copySqlBtn" onclick="copyToClipboard()"><i class="bi bi-clipboard me-1"></i>Copy</button>
                    </div>
                    <div class="card-body p-0">
                        <pre id="sqlCode" class="m-0 p-3 bg-dark text-success" style="overflow-x:auto;"><code>@Model.GeneratedSql</code></pre>
                    </div>
                    @if (Model.WasRepaired && !string.IsNullOrWhiteSpace(Model.OriginalSql))
                    {
                        <div class="card-footer border-top-0 bg-dark">
                            <details>
                                <summary class="text-warning small" style="cursor:pointer;">
                                    <i class="bi bi-exclamation-triangle me-1"></i> Original (invalid) SQL — click to expand
                                </summary>
                                <pre class="mt-2 p-2 text-warning small mb-0" style="white-space:pre-wrap;">@Model.OriginalSql</pre>
                            </details>
                        </div>
                    }
                </div>
            }

            @if (Model.HasData)
            {
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0"><i class="bi bi-table me-1"></i> Results — <span class="badge bg-secondary">@Model.RowCount row@(Model.RowCount == 1 ? "" : "s")</span></h6>
                    <div class="btn-group btn-group-sm" role="group">
                        <button class="btn btn-primary active" id="btnTable" onclick="showView('table')">Table</button>
                        @if (Model.ChartData != null)
                        {
                            <button class="btn btn-outline-primary" id="btnChart" onclick="showView('chart')">Chart</button>
                        }
                        @if (Model.IsPivotable)
                        {
                            <button class="btn btn-outline-primary" id="btnPivot" onclick="showView('pivot')">Pivot</button>
                        }
                    </div>
                </div>

                @* Table View *@
                <div id="tableView" class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered table-sm mb-0" id="resultsTable">
                                <thead class="table-dark">
                                    <tr>
                                        @foreach (var col in Model.Columns)
                                        {
                                            <th>@col</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.Rows)
                                    {
                                        <tr>
                                            @for (var ci = 0; ci < row.Count; ci++)
                                            {
                                                <td class="@(revenueColIndices.Contains(ci) ? "rev-m" : "")">@FormatCell(ci, row[ci])</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @if (Model.ChartData != null)
                {
                    @* Chart View *@
                    <div id="chartView" class="card border-0 shadow-sm mb-4 d-none">
                        <div class="card-body">
                            <div class="d-flex justify-content-end gap-2 mb-2">
                                <label class="form-label mb-0 align-self-center small text-muted">Chart type:</label>
                                <select class="form-select form-select-sm w-auto" id="chartTypeSelect" onchange="updateChartType(this.value)">
                                    <option value="bar" selected="@(Model.ChartData.ChartType == "bar" ? "selected" : null)">Bar</option>
                                    <option value="line" selected="@(Model.ChartData.ChartType == "line" ? "selected" : null)">Line</option>
                                    <option value="pie" selected="@(Model.ChartData.ChartType == "pie" ? "selected" : null)">Pie</option>
                                    <option value="doughnut" selected="@(Model.ChartData.ChartType == "doughnut" ? "selected" : null)">Doughnut</option>
                                </select>
                            </div>
                            <div style="position:relative; height:400px;">
                                <canvas id="analyticsChart"></canvas>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.IsPivotable)
                {
                    @* Pivot Table View *@
                    <div id="pivotView" class="card border-0 shadow-sm mb-4 d-none">
                        <div class="card-header d-flex align-items-center gap-3">
                            <span class="fw-semibold">🔄 Pivot Table</span>
                            <div class="ms-auto d-flex gap-2 align-items-center small">
                                <label class="mb-0 text-muted">Row:</label>
                                <select id="pivotRowSel" class="form-select form-select-sm w-auto" onchange="renderPivot()">
                                    @for (var i = 0; i < Model.Columns.Count; i++)
                                    {
                                        <option value="@i" selected="@(i == pivotRowColIdx ? "selected" : null)">@Model.Columns[i]</option>
                                    }
                                </select>
                                <label class="mb-0 text-muted">Column:</label>
                                <select id="pivotColSel" class="form-select form-select-sm w-auto" onchange="renderPivot()">
                                    @for (var i = 0; i < Model.Columns.Count; i++)
                                    {
                                        <option value="@i" selected="@(i == pivotColColIdx ? "selected" : null)">@Model.Columns[i]</option>
                                    }
                                </select>
                                <label class="mb-0 text-muted">Value:</label>
                                <select id="pivotValSel" class="form-select form-select-sm w-auto" onchange="renderPivot()">
                                    @for (var i = 0; i < Model.Columns.Count; i++)
                                    {
                                        <option value="@i" selected="@(i == pivotValColIdx ? "selected" : null)">@Model.Columns[i]</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive" id="pivotContainer"></div>
                        </div>
                    </div>
                }
            }
            else if (!Model.HasError)
            {
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-info-circle-fill me-1"></i> The query returned no results.
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/chart.js"></script>
    <script>
        // ── Chart setup ──────────────────────────────────────────────────────────
        var chartData = @Html.Raw(chartJson);
        var myChart = null;

        function buildChart(type) {
            if (!chartData) return;
            var ctx = document.getElementById('analyticsChart').getContext('2d');
            if (myChart) myChart.destroy();

            var isPieFamily = type === 'pie' || type === 'doughnut';
            var numDatasets = chartData.datasets.length;

            var datasets = chartData.datasets.map(function (ds, dsIdx) {
                // Pie/doughnut: one colour per slice (full array).
                // Single-dataset bar: one colour per bar (full array for rainbow bars).
                // Multi-dataset bar/line: one solid colour per dataset.
                var bg = (isPieFamily || numDatasets === 1)
                    ? ds.backgroundColor
                    : ds.backgroundColor[dsIdx % ds.backgroundColor.length];
                return {
                    label: ds.label,
                    data: ds.data,
                    backgroundColor: bg,
                    borderColor: ds.borderColor,
                    borderWidth: ds.borderWidth,
                    fill: false
                };
            });

            myChart = new Chart(ctx, {
                type: type,
                data: { labels: chartData.labels, datasets: datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'top' } }
                }
            });
        }

        function updateChartType(type) {
            buildChart(type);
        }

        // ── Raw data for pivot ───────────────────────────────────────────────────
        var rawRows = @Html.Raw(JsonConvert.SerializeObject(
            Model.Rows.Select(r => r.Select(v => v?.ToString()).ToList()).ToList()));

        // ── View switching ───────────────────────────────────────────────────────
        var VIEWS = ['table', 'chart', 'pivot'];

        function showView(view) {
            VIEWS.forEach(function(v) {
                var el = document.getElementById(v + 'View');
                var btn = document.getElementById('btn' + v.charAt(0).toUpperCase() + v.slice(1));
                if (!el) return;
                el.classList.toggle('d-none', v !== view);
                if (btn) {
                    btn.classList.toggle('active', v === view);
                    btn.classList.toggle('btn-primary', v === view);
                    btn.classList.toggle('btn-outline-primary', v !== view);
                }
            });

            if (view === 'chart' && !myChart && chartData) {
                buildChart(chartData.chartType);
            }
            if (view === 'pivot') {
                renderPivot();
            }
        }

        // ── Pivot table renderer ─────────────────────────────────────────────────
        function renderPivot() {
            var rowColIdx = parseInt(document.getElementById('pivotRowSel').value);
            var colColIdx = parseInt(document.getElementById('pivotColSel').value);
            var valColIdx = parseInt(document.getElementById('pivotValSel').value);

            // Collect unique row/col keys
            var rowKeys = [], colKeys = [], seen = {r: {}, c: {}};
            rawRows.forEach(function(row) {
                var rk = row[rowColIdx] || '(null)', ck = row[colColIdx] || '(null)';
                if (!seen.r[rk]) { seen.r[rk] = true; rowKeys.push(rk); }
                if (!seen.c[ck]) { seen.c[ck] = true; colKeys.push(ck); }
            });

            // Build lookup: rowKey → colKey → value (last wins / sum if numeric)
            var matrix = {};
            rawRows.forEach(function(row) {
                var rk = row[rowColIdx] || '(null)';
                var ck = row[colColIdx] || '(null)';
                var v = row[valColIdx];
                if (!matrix[rk]) matrix[rk] = {};
                var existing = matrix[rk][ck];
                var num = parseFloat(v);
                if (!isNaN(num) && existing !== undefined) {
                    matrix[rk][ck] = (parseFloat(existing) || 0) + num;
                } else {
                    matrix[rk][ck] = v !== null ? v : '';
                }
            });

            // Render HTML table
            var html = '<table class="table table-bordered table-sm table-hover mb-0"><thead class="table-dark"><tr><th></th>';
            colKeys.forEach(function(ck) { html += '<th>' + esc(ck) + '</th>'; });
            html += '</tr></thead><tbody>';
            rowKeys.forEach(function(rk) {
                html += '<tr><th class="table-secondary">' + esc(rk) + '</th>';
                colKeys.forEach(function(ck) {
                    var val = (matrix[rk] && matrix[rk][ck] !== undefined) ? matrix[rk][ck] : '—';
                    html += '<td>' + esc(String(val)) + '</td>';
                });
                html += '</tr>';
            });
            html += '</tbody></table>';
            document.getElementById('pivotContainer').innerHTML = html;
        }

        function esc(s) {
            return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }

        // ── Copy SQL ─────────────────────────────────────────────────────────────
        function copyToClipboard() {
            var code = document.getElementById('sqlCode').innerText;
            navigator.clipboard.writeText(code).then(function () {
                var btn = document.getElementById('copySqlBtn');
                btn.textContent = 'Copied!';
                setTimeout(function () { btn.textContent = 'Copy'; }, 2000);
            });
        }
    </script>
}
